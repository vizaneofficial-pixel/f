# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 or production origin)
APP_URL="http://localhost:3000"

# FRONTEND_URL & BACKEND_URL
# Local dev: FRONTEND_URL="http://localhost:3000", BACKEND_URL="http://localhost:3000"
# Production (Vercel): FRONTEND_URL="https://fenora-blush.vercel.app", BACKEND_URL="https://fenora-blush.vercel.app"
# Custom domain: FRONTEND_URL="https://fenora.in", BACKEND_URL="https://api.fenora.in"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# GOOGLE DRIVE MULTI-TENANT OAUTH CONFIGURATION
# Fenora Google Cloud OAuth 2.0 Web Application Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# GOOGLE_REDIRECT_URI: Must match one of the Authorized redirect URIs in Google Cloud Console
# Local dev: http://localhost:3000/api/drive/callback
# Production (Vercel): https://fenora-blush.vercel.app/api/drive/callback
# Production (Custom domain): https://api.fenora.in/api/drive/callback or https://fenora.in/api/drive/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"

# DRIVE_TOKEN_ENCRYPTION_KEY: 32-byte secret (or 64-character hex string) for AES-256-GCM encryption of CA firm refresh tokens.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
DRIVE_TOKEN_ENCRYPTION_KEY="replace-with-a-random-32-byte-secret-hex-key"

# GOOGLE CLOUD IAM SETUP FOR PRODUCTION BACKEND:
# When running on Google Cloud Run with Application Default Credentials (ADC),
# grant 'Cloud Datastore User' (roles/datastore.user) to the Cloud Run runtime service account:
# gcloud projects add-iam-policy-binding PROJECT_ID \
#   --member="serviceAccount:SERVICE_ACCOUNT_EMAIL" \
#   --role="roles/datastore.user"

# OPTIONAL: FIREBASE SERVICE ACCOUNT (Only needed when deploying outside Google Cloud, e.g. Vercel or external VPS)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# OPTIONAL: FIRESTORE DATABASE ID (Defaults to firebase-applet-config.json or '(default)')
# FIRESTORE_DATABASE_ID="ai-studio-65a80eac-e91a-4f13-9b76-ade4d39161aa"

